{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencode://security/external-runtime-validation-request-v1.schema.json",
  "title": "External Runtime Validation Request v1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_type",
    "request_id",
    "audit_id",
    "scope_digest",
    "finding_id",
    "finding_object_digest",
    "static_assessment",
    "source_binding",
    "attack_surface",
    "claim",
    "proof_gaps",
    "validation_policy",
    "provenance",
    "packet_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_type": { "const": "EXTERNAL_RUNTIME_VALIDATION_REQUEST" },
    "scope_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finding_object_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proof_gaps": { "type": "array", "minItems": 1 },
    "packet_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
