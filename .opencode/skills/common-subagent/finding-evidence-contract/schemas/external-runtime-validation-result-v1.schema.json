{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencode://security/external-runtime-validation-result-v1.schema.json",
  "title": "External Runtime Validation Result v1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_type",
    "request_id",
    "request_packet_digest",
    "audit_id",
    "scope_digest",
    "finding_id",
    "finding_object_digest",
    "validator",
    "outcome",
    "methods",
    "observations",
    "evidence_artifacts",
    "counterevidence",
    "residual_gaps",
    "safety_attestation",
    "packet_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_type": { "const": "EXTERNAL_RUNTIME_VALIDATION_RESULT" },
    "outcome": {
      "enum": ["SUPPORTED_RUNTIME", "REJECTED", "INCONCLUSIVE", "NOT_RUN"]
    },
    "packet_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
